{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
  
    "alwaysThinkingEnabled": false,
  
    "cleanupPeriodDays": 90,
  
    "attribution": {
      "commits": false,
      "pullRequests": false
    },
  
    "spinnerTipsEnabled": false,
  
    "permissions": {
      "deny": [
        "Bash(rm -rf *)",
        "Bash(rm -fr *)",
        "Bash(sudo *)",
        "Bash(git push --force*)",
        "Bash(git push *--force*)",
        "Bash(git reset --hard*)",
        "Edit(~/.ssh/**)",
        "Edit(~/.zshrc)",
        "Edit(~/.zshenv)",
        "Read(**/.env)",
        "Read(**/.env.*)",
        "Read(**/secrets/**)",
        "Read(~/.ssh/**)",
        "Read(~/.aws/**)"
      ]
    },
  
    "env": {
      "DISABLE_TELEMETRY": "1",
      "DISABLE_ERROR_REPORTING": "1",
      "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
      "BASH_DEFAULT_TIMEOUT_MS": "30000",
      "MCP_TIMEOUT": "10000"
    }
  }