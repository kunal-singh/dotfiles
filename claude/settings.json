{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 90,
  "env": {
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "BASH_DEFAULT_TIMEOUT_MS": "30000",
    "MCP_TIMEOUT": "10000",
    "EDITOR": "zed --wait",
    "ENABLE_LSP_TOOL": "1"
  },
  "attribution": {},
  "permissions": {
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(sudo *)",
      "Bash(git push --force*)",
      "Bash(git push *--force*)",
      "Bash(git reset --hard*)",
      "Edit(~/.ssh/**)",
      "Edit(~/.zshrc)",
      "Edit(~/.zshenv)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"decision\": \"block\", \"reason\": \"Use mcp__exa__web_search_exa instead of WebSearch.\"}'"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/hooks/pre-bash-no-force-delete.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/hooks/pre-bash-block-git-push-main.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/hooks/pre-bash-block-npm-in-pnpm-project.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/hooks/pre-bash-block-grep-find.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/hooks/pre-bash-warn-long-running.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/scripts/hooks/post-edit-quality-gate.js"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/hooks/post-write-shellcheck.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "workmux set-window-status working"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "workmux set-window-status working"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "workmux set-window-status waiting"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "workmux set-window-status done"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "hookify@claude-plugins-official": false,
    "plugin-dev@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": false,
    "pyright-lsp@claude-plugins-official": false,
    "tmux-capture@kunal-singh-plugins": true,
    "security-guidance@claude-plugins-official": false,
    "ralph-loop@claude-plugins-official": false,
    "pr-review-toolkit@claude-plugins-official": false,
    "code-simplifier@claude-plugins-official": false,
    "feature-dev@claude-plugins-official": false,
    "explanatory-output-style@claude-plugins-official": false,
    "code-review@claude-plugins-official": false,
    "context-manager@kunal-singh-plugins": true,
    "workflow@kunal-singh-plugins": false,
    "product-manager@kunal-singh-plugins": false,
    "architect@kunal-singh-plugins": false,
    "developer@kunal-singh-plugins": false,
    "frontend-design@claude-plugins-official": false,
    "document-skills@anthropic-agent-skills": true,
    "style-guide@kunal-singh-plugins": true,
    "superpowers@superpowers-marketplace": true,
    "skill-creator@claude-plugins-official": true,
    "ponytail@ponytail": true
  },
  "extraKnownMarketplaces": {
    "kunal-singh-plugins": {
      "source": {
        "source": "github",
        "repo": "kunal-singh/claude-code-plugins"
      }
    },
    "anthropic-agent-skills": {
      "source": {
        "source": "git",
        "url": "https://github.com/anthropics/skills.git"
      }
    },
    "superpowers-marketplace": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers-marketplace"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "spinnerTipsEnabled": false,
  "alwaysThinkingEnabled": false,
  "effortLevel": "high",
  "skipWorkflowUsageWarning": true
}
